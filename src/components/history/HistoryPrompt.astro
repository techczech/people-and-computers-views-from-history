---
import Icon from './HistoryIcon.astro';
import { copy } from '../../data/history/history-content';
interface Props {label:string;text:string}
const { label, text } = Astro.props;
---
<div data-prompt class="mb-6 last:mb-0">
      <div class="flex justify-between items-baseline mb-2">
        <span class="text-sm font-semibold text-slate-500 uppercase tracking-wider">{label}</span>
        <button 
          data-copy data-idle={copy.copyPrompt} data-success={copy.copied} data-failure={copy.copyFailed}
          class="text-xs flex items-center gap-1 text-blue-600 hover:text-blue-800 transition-colors font-medium"
        >
          <Icon name="Copy" size={14} />
          <span aria-live="polite">{copy.copyPrompt}</span>
        </button>
      </div>
      <div class="bg-slate-800 rounded-lg p-4 overflow-x-auto border border-slate-700 shadow-inner">
        <pre class="text-slate-200 font-mono text-sm whitespace-pre-wrap leading-relaxed">{text}</pre>
      </div>
    </div>
