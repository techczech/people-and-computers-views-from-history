---
import Icon from './HistoryIcon.astro';
import { copy } from '../../data/history/history-content';
import type { SummaryItem } from '../../data/history/history-types';
interface Props { summary: SummaryItem }
const { summary } = Astro.props;
---
<details data-filter-item data-search={JSON.stringify([summary.title])} class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden mb-8 transition-all duration-300">
      <summary 
        class="p-6 cursor-pointer hover:bg-slate-50 flex items-start justify-between gap-4 select-none"
      >
        <div>
           <h3 class="text-2xl font-bold text-slate-900 mb-2">{summary.title}</h3>
           <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-500">
             <span>{summary.metadata.date}</span>
             <span class="text-slate-300">{copy.text48}</span>
             <span>{summary.metadata.commissioningAgency}</span>
           </div>
        </div>
        <span class="text-slate-400 p-1 rounded-full">
          <Icon name="ChevronDown" size={24} />
        </span>
      </summary>

      
        <div class="p-6 pt-0 border-t border-slate-100">
          
          <div class="bg-slate-50 rounded-lg p-4 my-6 text-sm space-y-2 text-slate-600">
            <div class="flex gap-2">
               <span class="font-semibold w-24 flex-shrink-0">{copy.text49}</span>
               <span>{summary.metadata.originalTitle}</span>
            </div>
            <div class="flex gap-2">
               <span class="font-semibold w-24 flex-shrink-0">{copy.text50}</span>
               <span>{summary.metadata.authors}</span>
            </div>
            <div class="flex gap-2 items-center">
               <span class="font-semibold w-24 flex-shrink-0">{copy.text51}</span>
               <a href={summary.metadata.link} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline flex items-center gap-1">{copy.text52}<Icon name="LinkIcon" size={12} />
               </a>
            </div>
          </div>

          
          <div class="space-y-8">
            {summary.sections.map((section) => (<section>
                <h4 class="text-lg font-bold text-slate-800 mb-3 flex items-center gap-2">
                  <Icon name="FileText" size={18} class="text-blue-400" />
                  {section.title}
                </h4>
                <div 
                  class="prose prose-slate max-w-none prose-ul:list-disc prose-ol:list-decimal prose-li:my-1 text-slate-700"
                  set:html={section.content}
                />
              </section>
            ))}
          </div>
        </div>
    </details>
