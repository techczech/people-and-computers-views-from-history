---
import { copy } from '../../data/history/history-content';
import HistoryMethodBlock from './HistoryMethodBlock.astro';
import { METHOD_PROMPTS, INTRO_TEXT } from '../../data/history/history-content';
---
<div class="space-y-16 max-w-4xl">
      
      <div class="bg-white rounded-xl border border-slate-200 p-8 shadow-sm">
        <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed">
           <h3 class="text-2xl font-bold text-slate-900 mb-4">{copy.text40}</h3>
           <p class="mb-6 text-lg">{INTRO_TEXT}</p>
           
           <h4 class="text-lg font-bold text-slate-900 mt-8 mb-4">{copy.text41}</h4>
           <p>{copy.text42}<strong>{copy.text43}</strong>{copy.text44}<a href="https://aistudio.google.com/" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">{copy.text45}</a>{copy.text46}</p>
        </div>
      </div>

      <div class="bg-slate-50 rounded-xl border border-slate-200 p-8">
        <h3 class="text-xl font-bold text-slate-900 mb-8 border-b border-slate-200 pb-4">{copy.text47}</h3>
        
        <HistoryMethodBlock 
          id="timeline"
          title={copy.text33}
          prompts={METHOD_PROMPTS.timeline}
          note={copy.text34}
        />

        <div class="mt-12"></div>

        <HistoryMethodBlock 
          id="videos"
          title={copy.text35}
          prompts={METHOD_PROMPTS.videos}
        />

        <div class="mt-12"></div>

        <HistoryMethodBlock 
          id="quotes"
          title={copy.text36}
          prompts={METHOD_PROMPTS.quotes}
        />

        <div class="mt-12"></div>

        <HistoryMethodBlock 
          id="themes"
          title={copy.text37}
          prompts={METHOD_PROMPTS.themes}
        />

        <div class="mt-12"></div>

        <HistoryMethodBlock 
          id="summaries"
          title={copy.text38}
          prompts={METHOD_PROMPTS.summaries}
          note={copy.text39}
        />
      </div>

    </div>
