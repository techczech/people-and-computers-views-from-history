---
import Icon from './HistoryIcon.astro';
import { copy } from '../../data/history/history-content';
import HistoryFeatureCard from './HistoryFeatureCard.astro';
---
<div class="min-h-screen bg-slate-50 flex flex-col">
      
      <div class="bg-white border-b border-slate-200">
        <div class="max-w-5xl mx-auto px-6 py-20 md:py-28">
          <div class="max-w-3xl">
            <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 tracking-tight mb-6 leading-tight">{copy.text21}<span class="text-blue-600 block mt-2">{copy.text22}</span>
            </h1>
            <p class="text-xl text-slate-600 mb-8 leading-relaxed">{copy.text23}</p>
            <div class="flex flex-wrap gap-4">
              <button 
                data-open="methods"
                class="bg-blue-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-blue-700 transition-colors shadow-lg shadow-blue-200 flex items-center gap-2"
              >{copy.text24}<Icon name="ArrowRight" size={20} />
              </button>
            </div>
          </div>
        </div>
      </div>

      
      <div class="flex-1 max-w-5xl mx-auto px-6 py-20">
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-slate-900 mb-4">{copy.text25}</h2>
          <p class="text-slate-600 max-w-2xl">{copy.text26}</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <HistoryFeatureCard 
            icon="Clock"
            title={copy.text11}
            description={copy.text12}
            target="timeline"
          />
          <HistoryFeatureCard 
            icon="Video"
            title={copy.text13}
            description={copy.text14}
            target="videos"
          />
          <HistoryFeatureCard 
            icon="Quote"
            title={copy.text15}
            description={copy.text16}
            target="quotes"
          />
          <HistoryFeatureCard 
            icon="Layers"
            title={copy.text17}
            description={copy.text18}
            target="themes"
          />
          <HistoryFeatureCard 
            icon="FileText"
            title={copy.text19}
            description={copy.text20}
            target="summaries"
          />
          
        </div>
      </div>

      
      <footer class="bg-slate-900 text-slate-400 py-12 px-6 border-t border-slate-800">
        <div class="max-w-5xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6 text-center md:text-left">
          <div>
            <p class="font-semibold text-slate-200">{copy.text27}<a href="https://dominiklukes.net" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300 hover:underline">{copy.text28}</a></p>
            <p class="text-sm mt-1">{copy.text29}</p>
          </div>
          <div class="text-sm text-slate-500">
            <p>{copy.text30}</p>
          </div>
        </div>
      </footer>
    </div>
