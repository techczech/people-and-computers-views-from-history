---
import Icon from './HistoryIcon.astro';
import { copy } from '../../data/history/history-content';
import type { ThemeItem } from '../../data/history/history-types';
interface Props { themes: ThemeItem[] }
const { themes } = Astro.props;
---
<div class="space-y-16">
      {themes.map((theme) => (<div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <h3 class="text-2xl font-bold text-slate-900 mb-4">{theme.title}</h3>
          <p class="text-slate-600 mb-8 text-lg leading-relaxed border-l-4 border-blue-500 pl-4">{theme.description}</p>
          
          <div class="space-y-6">
            <h4 class="text-sm font-bold uppercase tracking-wider text-slate-400">{copy.text8}</h4>
            {theme.examples.map((ex) => (<div class="flex gap-4 group">
                <div class="mt-1 flex-shrink-0">
                  <Icon name="CheckCircle2" class="h-6 w-6 text-blue-400 group-hover:text-blue-600 transition-colors" />
                </div>
                <div>
                  <p class="font-semibold text-slate-900 mb-1">{ex.context}</p>
                  <blockquote class="text-slate-600 italic mb-1">"{ex.quote}"</blockquote>
                  <p class="text-sm text-slate-400">— {ex.source}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
