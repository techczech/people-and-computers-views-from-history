---
import Icon from './HistoryIcon.astro';
import type { TimelineEvent } from '../../data/history/history-types';
interface Props { events: TimelineEvent[] }
const { events } = Astro.props;
---
<div class="relative border-l-2 border-slate-200 ml-4 md:ml-6 space-y-12 py-4">
      {events.map((event) => (<div data-filter-item data-search={JSON.stringify([event.title, event.description])} class="relative pl-8 md:pl-12 group">
          
          <div class="absolute -left-[9px] top-1 h-5 w-5 rounded-full border-4 border-white bg-blue-500 shadow-sm group-hover:bg-blue-600 transition-colors" />
          
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 mb-2">
            <span class="text-sm font-bold text-blue-600 bg-blue-50 px-2 py-1 rounded-md inline-flex items-center gap-1">
              <Icon name="Calendar" size={14} />
              {event.year}
            </span>
            <h3 class="text-xl font-bold text-slate-800">{event.title}</h3>
          </div>
          
          <p class="text-slate-600 mb-4 text-lg leading-relaxed">{event.description}</p>
          
          <div class="relative bg-slate-50 p-4 rounded-lg border-l-4 border-blue-400">
             <Icon name="Quote" class="absolute top-4 left-2 text-blue-200 h-6 w-6 -z-0 opacity-50 transform -scale-x-100" />
             <p class="italic text-slate-700 relative z-10 pl-6 font-serif">
               "{event.quote}"
             </p>
          </div>
        </div>
      ))}
    </div>
