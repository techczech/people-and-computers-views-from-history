---
import Icon from './HistoryIcon.astro';
import { copy } from '../../data/history/history-content';
interface Props {icon:string;title:string;description:string;target:string}
const { icon, title, description, target } = Astro.props;
---
  <button 
    data-open={target}
    class="flex flex-col items-start p-6 bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md hover:border-blue-300 transition-all text-left w-full group"
  >
    <div class="bg-blue-50 p-3 rounded-lg text-blue-600 mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
      <Icon name={icon} size={24} />
    </div>
    <h3 class="text-lg font-bold text-slate-900 mb-2">{title}</h3>
    <p class="text-slate-600 text-sm leading-relaxed">{description}</p>
    <div class="mt-4 text-blue-600 text-sm font-medium flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">{copy.text10}<Icon name="ArrowRight" size={14} />
    </div>
  </button>
